fn make_counter() {
    let count = 0;
    fn increment() {
        count = count + 1;
        return count;
    }
    return increment;
}

let counter1 = make_counter();
let counter2 = make_counter();

print(counter1()); // 1
print(counter1()); // 2
print(counter2()); // 1
print(counter1()); // 3

// Test lambdas
let double = fn(x) { return x * 2; };
print(double(5)); // 10
