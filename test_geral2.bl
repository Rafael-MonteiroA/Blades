class Animal {
    fn init(nome) {
        this.nome = nome;
    }
    fn falar() {
        print("Som generico.");
    }
}

class Cachorro < Animal {
    fn falar() {
        print("Late: Au au!");
    }
    fn comer() {
        super.falar();
        print("Comendo.");
    }
}

let dog = Cachorro("Rex");
dog.falar();
dog.comer();
