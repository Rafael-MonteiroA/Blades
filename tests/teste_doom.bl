window_init(800, 600, "Blades DOOM CLONE - MODO HORDA");
init_audio(); 

load_texture("tests/wall.png");
load_texture("tests/monster1.png");
load_texture("tests/monster2.png");

disable_cursor();
init_camera(0.0, 1.5, 0.0, 0.0, 1.5, 1.0);

let score = 0;
let game_over = 0;
let shoot_timer = 0.0;
let anim_timer = 0.0;

// Definindo a Classe do Monstro usando POO!
class Monstro {
    fn init(start_x, start_z) {
        this.x = start_x;
        this.y = 1.5;
        this.z = start_z;
        this.speed = 3.0;
        this.vivo = 1;
    }

    fn atualizar_posicao(dt, cx, cz) {
        if (this.vivo == 0) { return 0; }

        let dx = cx - this.x;
        let dz = cz - this.z;
        let dist = distance_3d(this.x, 0.0, this.z, cx, 0.0, cz);

        if (dist > 1.5) {
            this.x = this.x + (dx / dist) * this.speed * dt;
            this.z = this.z + (dz / dist) * this.speed * dt;
        } else {
            game_over = 1; // Monstro te pegou!
        }
    }

    fn desenhar(anim_timer) {
        if (this.vivo == 0) { return 0; }
        
        let bounce_y = this.y;
        if (anim_timer > 0.2) { bounce_y = 1.6; } 
        else { bounce_y = 1.4; }

        if (anim_timer > 0.2) {
            draw_billboard("tests/monster1.png", this.x, bounce_y, this.z, 4.0, 255, 255, 255);
        } else {
            draw_billboard("tests/monster2.png", this.x, bounce_y, this.z, 4.0, 255, 255, 255);
        }
    }
}

// Criando um Array de Monstros
let monstros = [
    Monstro(20.0, 20.0),
    Monstro(-20.0, 20.0),
    Monstro(20.0, -20.0),
    Monstro(-20.0, -20.0),
    Monstro(0.0, 30.0)
];

print("DOOM HORDA INICIADO! Mate os 5 monstros!");

while (!window_should_close()) {
    let dt = get_frame_time();
    if (dt > 0.1) { dt = 0.1; }

    if (game_over == 1) {
        begin_drawing();
        clear_background(0, 0, 0);
        draw_text("GAME OVER!", 300, 250, 40, 255, 0, 0);
        draw_text("Eles te pegaram...", 300, 300, 20, 255, 255, 255);
        end_drawing();
    } else {
        update_camera_first_person();
        let cx = get_camera_x();
        let cz = get_camera_z();

        if (shoot_timer > 0.0) { shoot_timer = shoot_timer - dt; }
        if (shoot_timer < 0.0) { shoot_timer = 0.0; }

        anim_timer = anim_timer + dt;
        if (anim_timer > 0.4) { anim_timer = 0.0; }

        // Lógica de Atirar
        if (is_mouse_button_pressed("LEFT")) {
            shoot_timer = 0.15;
            play_sound("tests/shoot.wav");

            // Verifica colisão do tiro com TODOS os monstros
            for (let i = 0; i < len(monstros); i = i + 1) {
                let m = monstros[i];
                if (m.vivo == 1) {
                    let dist = distance_3d(m.x, 0.0, m.z, cx, 0.0, cz);
                    if (dist < 50.0) {
                        m.vivo = 0;
                        score = score + 1;
                        print("Monstro abatido! Restam:", 5 - score);
                        // Quebra o loop para não matar 2 monstros com 1 tiro
                        i = len(monstros); 
                    }
                }
            }
        }

        // Atualiza a posição de todos os monstros
        for (let i = 0; i < len(monstros); i = i + 1) {
            monstros[i].atualizar_posicao(dt, cx, cz);
        }

        // Começa a desenhar
        begin_drawing();
        clear_background(50, 80, 50);

        if (shoot_timer > 0.0) {
            clear_background(255, 255, 200); // Flash do tiro
        }

        begin_mode_3d();
        draw_cube(0.0, -0.5, 0.0, 200.0, 1.0, 200.0, 50, 80, 50);

        draw_cube_texture("tests/wall.png", 0.0, 4.0, 100.0, 200.0, 8.0, 1.0, 255, 255, 255);
        draw_cube_texture("tests/wall.png", 0.0, 4.0, -100.0, 200.0, 8.0, 1.0, 255, 255, 255);
        draw_cube_texture("tests/wall.png", 100.0, 4.0, 0.0, 1.0, 8.0, 200.0, 255, 255, 255);
        draw_cube_texture("tests/wall.png", -100.0, 4.0, 0.0, 1.0, 8.0, 200.0, 255, 255, 255);

        // Desenha todos os monstros
        for (let i = 0; i < len(monstros); i = i + 1) {
            monstros[i].desenhar(anim_timer);
        }

        end_mode_3d();

        // UI 2D
        draw_text("Mate todos!", 10, 10, 20, 255, 255, 255);
        
        // Mira
        draw_rectangle(400 - 2, 300 - 10, 4, 20, 0, 255, 0);
        draw_rectangle(400 - 10, 300 - 2, 20, 4, 0, 255, 0);

        if (score == 5) {
            draw_text("VITORIA!", 300, 250, 40, 0, 255, 0);
        }

        end_drawing();
    }
}
