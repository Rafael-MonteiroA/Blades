window_init(800, 600, "Blades - Collect the Spheres 3D");

let player_x = 0.0;
let player_z = 0.0;
let player_speed = 10.0;

let target_x = 5.0;
let target_z = 5.0;
let score = 0;

print("Game Started: Collect the green spheres!");

while (!window_should_close()) {
    let dt = get_frame_time();

    // Input
    if (is_key_down("W")) {
        player_z = player_z - player_speed * dt;
    }
    if (is_key_down("S")) {
        player_z = player_z + player_speed * dt;
    }
    if (is_key_down("A")) {
        player_x = player_x - player_speed * dt;
    }
    if (is_key_down("D")) {
        player_x = player_x + player_speed * dt;
    }

    // Basic collision detection (distance squared)
    let dx = player_x - target_x;
    let dz = player_z - target_z;
    let dist2 = dx * dx + dz * dz;

    if (dist2 < 4.0) {
        // Collect!
        score = score + 1;
        target_x = random(-10, 10);
        target_z = random(-10, 10);
        print("Score: ", score);
    }

    // Drawing
    begin_drawing();
    clear_background(30, 30, 30);

    // 3D Mode
    // Camera looking at the origin, but moved back and up
    begin_mode_3d(0, 15, 15, 0, 0, 0);
    
    // Draw grid/ground base (lines)
    draw_line_3d(-15, 0, 0, 15, 0, 0, 100, 100, 100);
    draw_line_3d(0, 0, -15, 0, 0, 15, 100, 100, 100);
    
    // Draw target (green sphere)
    draw_sphere(target_x, 0.5, target_z, 1.0, 0, 255, 0);

    // Draw player (red cube)
    draw_cube(player_x, 0.5, player_z, 2, 2, 2, 255, 0, 0);

    end_mode_3d();

    // 2D Mode (UI)
    draw_text("SCORE IS IN CONSOLE!", 20, 20, 30, 255, 255, 255);
    draw_text("Use W A S D to move and catch the green spheres!", 20, 60, 20, 200, 200, 200);

    end_drawing();
}

window_close();
print("Final Score: ", score);
