print("=== Testando For, Stdlib e Arrays ===");

// 1. Arrays e Loop For
let numeros = [10, 20, 30, 40, 50];
print("Array inicial: ", numeros);
print("Tamanho do array: ", len(numeros));

print("Alterando valores do array com loop...");
for (let i = 0; i < len(numeros); i = i + 1) {
    numeros[i] = random(1, 100);
}

print("Array depois das mudancas: ", numeros);

// 2. Stdlib: Input
let nome = input("Digite seu nome para finalizarmos o teste: ");
print("Ola ", nome, "! Seu nome tem ", len(nome), " letras.");
