---
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# Brace style: Allman (opening brace on its own line)
BreakBeforeBraces: Allman

# Namespace indentation: none
NamespaceIndentation: None

# Pointer alignment
PointerAlignment: Left

# Include sorting
SortIncludes: CaseSensitive
IncludeBlocks: Regroup

# Constructor initializer lists
BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 4

# Allow short functions/ifs on one line only if trivial
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Align consecutive items for readability
AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
AlignConsecutiveDeclarations:
  Enabled: false

# Trailing comma in parameter lists
InsertTrailingCommas: None

# Template angle brackets
SpaceAfterTemplateKeyword: true

# Penalty for breaking long lines
PenaltyBreakBeforeFirstCallParameter: 19
PenaltyReturnTypeOnItsOwnLine: 60
