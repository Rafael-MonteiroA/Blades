{
  "name": "blades-lang",
  "displayName": "Blades Language",
  "description": "Syntax highlighting for the Blades programming language",
  "version": "0.1.1",
  "publisher": "RafaelMonteiro",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:blades"
  ],
  "contributes": {
    "languages": [
      {
        "id": "blades",
        "aliases": ["Blades", "blades"],
        "extensions": [".bl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blades",
        "scopeName": "source.blades",
        "path": "./syntaxes/blades.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "blades.run",
        "title": "Run Blades Script",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "blades.run",
          "when": "resourceExtname == .bl",
          "group": "navigation"
        }
      ]
    }
  }
}
