print("=== 1. Dicionarios ===");
let pessoa = {
    "nome": "Rafael",
    "idade": 25
};
print(pessoa["nome"]);
pessoa["idade"] = 26;
print(pessoa["idade"]);

print("\n=== 2. Herança e F-Strings ===");
class Animal {
    fn init(nome) {
        this.nome = nome;
    }
    fn falar() {
        print(f"{this.nome} faz um som generico.");
    }
}

class Cachorro < Animal {
    fn falar() {
        print(f"{this.nome} late: Au au!");
    }
    fn comer() {
        super.falar();
        print(f"{this.nome} esta comendo.");
    }
}

let dog = Cachorro("Rex");
dog.falar();
dog.comer();

print("\n=== 3. F-Strings Avançadas ===");
let a = 10;
let b = 20;
print(f"A soma de {a} e {b} eh {a + b}!");
